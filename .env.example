# Copy this file to .env and fill in real values.
# Never commit .env because it contains secrets.
APP_NAME=fraudfirstaid
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Use your Neon direct connection string in .env only.
# This placeholder is safe to commit.
DATABASE_URL=postgresql://localhost:5432/fraudfirstaid
# LLM keys (Day 8). Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Real values go in .env, GitHub Secrets and Render only. Never in Git.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
